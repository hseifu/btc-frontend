    ]
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-react": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
